<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<title>{{ seo.title }}</title>
		<meta charset="utf-8">
		<meta name="google" content="notranslate">
		<meta name="keyword" content="{{ seo.keyword }}">
		<meta name="description" content="{{ seo.desc }}">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&display=swap">
		{% block css %}
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.0/dist/css/bootstrap.min.css">
			<link rel="stylesheet" type="text/css" href="/assets/css/style.css">
		{% endblock %}
        <script>
            window.$$global = {{ global|json_encode|raw }}
            window.$$routerVar = {{ router|json_encode|raw }}
        </script>
	</head>
	<body class="site" data-config='{{ global|json_encode|raw }}'>
		{% set current = global.uri|split('?')|first %}
		<a class="skip-link" href="#app">跳到内容</a>
		<header class="site-header">
			<div class="shell site-header-inner">
				<a class="brand" href="/">
					<span class="brand-mark" aria-hidden="true">文</span>
					<span class="brand-text">
						<span class="brand-name">文库</span>
						<span class="brand-kicker">Archive</span>
					</span>
				</a>
				<nav class="site-nav" aria-label="主导航">
					<a href="/" {% if current == '/' or current starts with '/detail' %}aria-current="page"{% endif %}>列表</a>
					<a href="/contact" {% if current starts with '/contact' %}aria-current="page"{% endif %}>表单</a>
					<a href="/company" {% if current starts with '/company' %}aria-current="page"{% endif %}>简介</a>
					<a href="/4a/login" {% if current starts with '/4a/login' %}aria-current="page"{% endif %}>登录</a>
				</nav>
			</div>
		</header>
		<main id="app" class="shell site-main">
			{% block content %}
				<div></div>
			{% endblock %}
		</main>
		<footer class="site-footer">
			<div class="shell">
				<p>文库 · 文章、简介与留言</p>
			</div>
		</footer>
        <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
		{% block js %}
			<script src="/assets/js/main.js"></script>
		{% endblock %}
	</body>
</html>
