<!DOCTYPE html>
<html lang="zh-CN">
	<head>
		<title>{{ seo.title }}</title>
		<meta charset="utf-8">
		<meta name="google" content="notranslate">
		<meta name="keyword" content="{{ seo.keyword }}">
		<meta name="description" content="{{ seo.desc }}">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="preconnect" href="https://gstatic.aby.pub">
		<link rel="preconnect" href="https://gstatic.aby.pub" crossorigin>
		<link rel="stylesheet" href="https://gstatic.aby.pub/css2?family=Libre+Bodoni:wght@500;600;700&family=Public+Sans:wght@400;500;600;700&display=swap">
		{% block css %}
			<link rel="stylesheet" href="https://cdn.jsdmirror.com/npm/bootstrap@4.5.0/dist/css/bootstrap.min.css">
			<link rel="stylesheet" type="text/css" href="/assets/css/style.css">
		{% endblock %}
        <script>
            window.$$global = {{ global|json_encode|raw }}
            window.$$routerVar = {{ router|json_encode|raw }}
        </script>
	</head>
	<body class="site" data-config='{{ global|json_encode|raw }}'>
		{% set current = global.uri|split('?')|first %}
		<a class="skip-link" href="#app">跳到内容</a>
		<header class="site-header">
			<div class="shell site-header-inner">
				<a class="brand" href="/">
					<span class="brand-mark" aria-hidden="true">笑</span>
					<span class="brand-text">
						<span class="brand-name">笑一笑</span>
						<span class="brand-kicker">Laugh</span>
					</span>
				</a>
				<nav class="site-nav" aria-label="主导航">
					<a href="/" {% if current == '/' or current starts with '/detail' %}aria-current="page"{% endif %}>列表</a>
					<a href="/archive" {% if current starts with '/archive' %}aria-current="page"{% endif %}>归档</a>
					<a href="/about" {% if current starts with '/about' %}aria-current="page"{% endif %}>关于</a>
				</nav>
			</div>
		</header>
		<main id="app" class="shell site-main">
			{% block content %}
				<div></div>
			{% endblock %}
		</main>
		<footer class="site-footer">
			<div class="shell">
				<p>笑一笑 · 段子与归档</p>
			</div>
		</footer>
        <script src="https://cdn.jsdmirror.com/npm/jquery/dist/jquery.min.js"></script>
		{% block js %}
			<script src="/assets/js/main.js"></script>
		{% endblock %}
	</body>
</html>
